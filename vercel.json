{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "regions": ["icn1"],
  "functions": {
    "api/instagram.mjs": { "maxDuration": 300 },
    "api/instagram-link.mjs": { "maxDuration": 60 },
    "api/content-search.mjs": { "maxDuration": 60 },
    "api/media.py": { "maxDuration": 120, "excludeFiles": "{node_modules/**,public/**,**/*_test.py,**/*.test.mjs}" },
    "api/cleanup.mjs": { "maxDuration": 120 },
    "api/calendar.mjs": { "maxDuration": 30 },
    "api/taste.mjs": { "maxDuration": 30 },
    "api/reminders.mjs": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/cleanup", "schedule": "40 18 * * *" }],
  "rewrites": [
    { "source": "/api/calendar/:id", "destination": "/api/calendar?id=:id" },
    { "source": "/api/taste/:id", "destination": "/api/taste?id=:id" },
    { "source": "/api/reminders/run", "destination": "/api/reminders" },
    { "source": "/health", "destination": "/api/instagram" },
    { "source": "/webhooks/instagram", "destination": "/api/instagram" },
    { "source": "/auth/start", "destination": "/api/instagram" },
    { "source": "/auth/instagram/callback", "destination": "/api/instagram" },
    { "source": "/auth/result", "destination": "/api/instagram" },
    { "source": "/home", "destination": "/dashboard" },
    { "source": "/library", "destination": "/dashboard" },
    { "source": "/taste", "destination": "/dashboard" },
    { "source": "/calendar", "destination": "/dashboard" },
    { "source": "/map", "destination": "/dashboard" },
    { "source": "/settings", "destination": "/dashboard" },
    { "source": "/items/:id", "destination": "/dashboard" }
  ],
  "headers": [
    {
      "source": "/((?!api/|health|webhooks/|auth/|(?:dashboard|home|library|taste|calendar|map|settings)/?$|items/[^/]+/?$).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://epokaecxlgymchtqnjkn.supabase.co https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/((?:dashboard|home|library|taste|calendar|map|settings)/?|items/[^/]+/?)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://dapi.kakao.com https://t1.daumcdn.net https://*.kakaocdn.net; connect-src 'self' https://epokaecxlgymchtqnjkn.supabase.co https://cdn.jsdelivr.net https://dapi.kakao.com https://*.kakaocdn.net; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.daumcdn.net https://*.kakaocdn.net; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
