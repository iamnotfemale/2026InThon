{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "regions": ["icn1"],
  "functions": { "api/instagram.mjs": { "maxDuration": 300 } },
  "rewrites": [
    { "source": "/health", "destination": "/api/instagram" },
    { "source": "/webhooks/instagram", "destination": "/api/instagram" },
    { "source": "/auth/start", "destination": "/api/instagram" },
    { "source": "/auth/instagram/callback", "destination": "/api/instagram" },
    { "source": "/auth/result", "destination": "/api/instagram" }
  ],
  "headers": [
    {
      "source": "/((?!api/|health|webhooks/|auth/).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://epokaecxlgymchtqnjkn.supabase.co https://cdn.jsdelivr.net; style-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
